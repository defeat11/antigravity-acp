{
  "manifest_version": 3,
  "name": "ACP WebBridge",
  "version": "1.0.0",
  "description": "ACP WebBridge extension for driving user Chrome profile via CDP",
  "minimum_chrome_version": "116",
  "permissions": [
    "debugger",
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ACP WebBridge"
  }
}
