# Antigravity ACP adapter — configuration (all optional; safe defaults shown)

# Path or bare name of the Antigravity CLI. Resolved on PATH (with .exe/.cmd on
# Windows). Set to a full path if `agy` is not on PATH.
ACP_AGY_BIN=agy

# Model id passed to `agy --model`. Default targets Gemini 3.6 Flash, High tier.
# NOTE: some agy installs only recognize `gemini-3.6-flash-low`; other ids
# (incl. -high/-medium) fall back to the Medium default and the adapter logs a
# one-time warning. Set to empty to use agy's default cleanly (no --model flag).
# Run `agy models` to list every id your install recognizes.
#   gemini-3.6-flash-high | gemini-3.6-flash-low | (empty = Medium default)
ACP_AGY_MODEL=gemini-3.6-flash-high

# How agy's tool-permission gate behaves in non-interactive print mode:
#   auto    -> --dangerously-skip-permissions (agy edits files / runs tools freely)
#   sandbox -> --sandbox + skip prompts (restricted terminal)
#   default -> neither (agy may refuse or wait until the print timeout)
ACP_AGY_PERMISSION_MODE=auto

# Value for `agy --print-timeout` (Go duration string).
ACP_AGY_PRINT_TIMEOUT=10m

# Conversation continuity across prompts in one session:
#   continue   -> use `agy --continue` when safe, else inject transcript
#   transcript -> always inject this session's transcript as context
#   off        -> every prompt is independent
ACP_AGY_PERSIST=continue

# Ask the ACP client (editor) for consent before running agy:
#   off     -> never ask
#   session -> ask once per session
#   always  -> ask before every prompt
ACP_AGY_CONSENT=off

# Advanced: extra raw args appended to every agy invocation (shell-style quoting).
# ACP_AGY_EXTRA_ARGS=--add-dir /extra/workspace

# Max characters of prior-turn transcript injected as context (fallback only;
# normally continuity is delegated to agy via --conversation).
ACP_MAX_CONTEXT_CHARS=24000

# Max agy processes allowed to run at once across all sessions (each agy run
# starts a full language server, so keep this modest).
ACP_AGY_MAX_CONCURRENT=3

# Set to 1 to never spawn agy — streams a canned response. Useful for tests/CI.
ACP_AGY_DRY_RUN=0

# Logging verbosity: debug | info | warn | error  (logs go to stderr only).
ACP_LOG_LEVEL=info

# Optional shared SKILL.md roots. Use semicolons on Windows, colons on Unix.
# Project-local skills are composed with these; no skill file is overwritten.
# ACP_SKILLS_ROOTS=/opt/shared-skills:/opt/team-skills

# Antigravity API key for headless auth (read by agy itself, passed through).
# ANTIGRAVITY_API_KEY=your_key_here
